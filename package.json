    "@capacitor/splash-screen": "latest",
    "@capacitor/status-bar": "^8.0.3",
    "@lucide/vue": "^1.31.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "pinia": "^4.0.3",
